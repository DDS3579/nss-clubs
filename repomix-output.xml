.section {
  --parallax-shift: 0px;
  position: relative;
  overflow: visible;
  background:
    radial-gradient(circle at 50% 42%, rgba(212, 163, 115, 0.1), transparent 30%),
    linear-gradient(180deg, #f8fafc 0%, #ffffff 30%, #ffffff 100%);
  padding: clamp(72px, 9vw, 108px) 20px clamp(76px, 10vw, 120px);
}

.section::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle, rgba(26, 51, 120, 0.18) 1px, transparent 1.5px),
    radial-gradient(circle, rgba(200, 144, 58, 0.16) 1px, transparent 1.5px);
  background-position: 7% 18%, 89% 26%;
  background-size: 160px 160px, 220px 220px;
  opacity: 0.38;
}

.inner {
  position: relative;
  z-index: 1;
  width: min(100%, 1120px);
  margin: 0 auto;
  transform: translate3d(0, var(--parallax-shift), 0);
  will-change: transform;
}

.heading {
  max-width: 680px;
  margin: 0 auto 34px;
  text-align: center;
}

.eyebrow {
  margin-bottom: 10px;
  color: #c8903a;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.title {
  margin: 0;
  color: #0d2460;
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 900;
  line-height: 1.08;
}

.title em {
  color: #c8903a;
  font-style: italic;
}

.subtitle {
  max-width: 560px;
  margin: 14px auto 0;
  color: #64748b;
  font-size: 15px;
  line-height: 1.7;
}

.orbitStage {
  --inner-radius: clamp(92px, 17vw, 168px);
  --outer-radius: clamp(154px, 28vw, 282px);
  position: relative;
  width: min(100%, 820px);
  height: clamp(470px, 66vw, 680px);
  margin: 0 auto;
}

.constellationLines {
  position: absolute;
  inset: 8% 5%;
  width: 90%;
  height: 84%;
  pointer-events: none;
  opacity: 0;
}

.isVisible .constellationLines {
  animation: linesCollapse 1.15s ease-out forwards;
}

.isExiting .constellationLines {
  animation: linesExpand 1s ease-out forwards;
}

.line {
  stroke: rgba(26, 51, 120, 0.16);
  stroke-width: 1;
  stroke-dasharray: 7 10;
}

.ringGuide {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1px solid rgba(26, 51, 120, 0.12);
  border-radius: 999px;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.86);
}

.innerGuide {
  width: calc(var(--inner-radius) * 2);
  height: calc(var(--inner-radius) * 2);
}

.outerGuide {
  width: calc(var(--outer-radius) * 2);
  height: calc(var(--outer-radius) * 2);
}

.isVisible .ringGuide {
  animation: guideReveal 0.9s ease-out 1.05s forwards;
}

.isExiting .ringGuide {
  animation: guideHide 0.65s ease-in forwards;
}

.nucleus {
  position: absolute;
  top: 50%;
  left: 50%;
  width: clamp(84px, 12vw, 122px);
  height: clamp(84px, 12vw, 122px);
  border: 1px solid rgba(122, 80, 0, 0.2);
  border-radius: 999px;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 220, 0.92), rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0) 58%, rgba(60, 30, 0, 0.5) 100%),
    linear-gradient(135deg, #fff8c0 0%, #f5d84a 20%, #d4a373 50%, #e8c050 80%, #a06800 100%),
    #7a5000;
  box-shadow:
    0 18px 38px rgba(13, 36, 96, 0.11),
    inset 0 -14px 24px rgba(60, 30, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.45);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.78);
}

.nucleus::before {
  content: "";
  position: absolute;
  inset: 12%;
  border-radius: inherit;
  background: radial-gradient(circle at 22% 20%, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0) 48%);
}

.nucleus::after {
  content: "";
  position: absolute;
  inset: 0;
  border: 1px solid rgba(255, 179, 0, 0.14);
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(60, 30, 0, 0.1));
  box-shadow: inset 0 0 16px rgba(60, 30, 0, 0.18);
}

.isVisible .nucleus {
  animation: nucleusReveal 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
}

.isExiting .nucleus {
  animation: nucleusHide 0.65s ease-in forwards;
}

.orbitRing {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform-origin: 50% 50%;
}

.isVisible .orbitRing {
  opacity: 1;
  animation: orbitClockwise var(--orbit-duration) linear 2s infinite;
}

.isVisible .outerRing {
  animation-name: orbitCounterClockwise;
}

.isExiting .orbitRing {
  opacity: 1;
  animation: none;
}

.orbitSlot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: clamp(74px, 10vw, 112px);
  height: clamp(74px, 10vw, 112px);
  opacity: 0;
  transform:
    translate(-50%, -50%)
    translate(var(--collapse-x), var(--collapse-y))
    scale(0.2);
  transform-origin: center;
  will-change: transform, opacity;
}

.outerRing .orbitSlot {
  width: clamp(82px, 12vw, 132px);
  height: clamp(82px, 12vw, 132px);
}

.isVisible .orbitSlot {
  animation: collapseToOrbit 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: var(--delay);
}

.isExiting .orbitSlot {
  animation: orbitToCollapse 1s ease-in forwards;
  animation-delay: var(--exit-delay);
}

.photoFrame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border: 4px solid rgba(255, 255, 255, 0.92);
  border-radius: 999px;
  background: linear-gradient(135deg, #eef2f7, #ffffff);
  box-shadow:
    0 16px 34px rgba(13, 36, 96, 0.16),
    0 0 0 1px rgba(13, 36, 96, 0.08);
}

.photoFrame img {
  object-fit: cover;
}

.placeholder {
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  border-radius: inherit;
  background:
    radial-gradient(circle at 36% 30%, #ffffff, #e7edf5 58%, #d7e0ec 100%);
}

.placeholder::after {
  content: "";
  width: 14px;
  height: 14px;
  border-radius: 999px;
  background: rgba(13, 36, 96, 0.32);
}

.caption {
  position: absolute;
  left: 50%;
  top: calc(100% + 10px);
  max-width: 140px;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.25;
  opacity: 0;
  text-align: center;
  transform: translateX(-50%);
  transition: opacity 250ms ease;
}

.scrollBridge {
  position: fixed;
  inset: 0;
  z-index: 22;
  pointer-events: none;
  opacity: 0;
  transition: opacity 160ms ease;
}

.scrollBridgeActive {
  opacity: 1;
}

.bridgeSvg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.bridgeLine {
  fill: none;
  stroke: rgba(26, 51, 120, 0.16);
  stroke-width: 1;
  stroke-dasharray: 8 10;
}

.bridgeParticle {
  position: absolute;
  left: 0;
  top: 0;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #1a3378;
  box-shadow: 0 0 0 8px rgba(26, 51, 120, 0.05);
  opacity: 0;
  transform: translate3d(-999px, -999px, 0);
  will-change: transform, opacity, width, height;
}

.bridgeParticleGold {
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 220, 0.92), rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0) 58%, rgba(60, 30, 0, 0.48) 100%),
    linear-gradient(135deg, #fff8c0 0%, #f5d84a 20%, #d4a373 50%, #e8c050 80%, #a06800 100%),
    #7a5000;
  box-shadow:
    0 0 0 1px rgba(122, 80, 0, 0.16),
    inset 0 -4px 8px rgba(60, 30, 0, 0.22);
}

.orbitSlot:hover .caption,
.orbitSlot:focus-within .caption {
  opacity: 1;
}

@keyframes collapseToOrbit {
  0% {
    opacity: 0;
    transform:
      translate(-50%, -50%)
      translate(var(--collapse-x), var(--collapse-y))
      scale(0.2);
  }
  36% {
    opacity: 1;
  }
  100% {
    opacity: 1;
    transform:
      translate(-50%, -50%)
      rotate(var(--orbit-angle))
      translateX(var(--orbit-radius))
      rotate(var(--counter-angle))
      scale(1);
  }
}

@keyframes orbitToCollapse {
  0% {
    opacity: 1;
    transform:
      translate(-50%, -50%)
      rotate(var(--orbit-angle))
      translateX(var(--orbit-radius))
      rotate(var(--counter-angle))
      scale(1);
  }
  72% {
    opacity: 0.92;
  }
  100% {
    opacity: 0;
    transform:
      translate(-50%, -50%)
      translate(var(--collapse-x), var(--collapse-y))
      scale(0.2);
  }
}

@keyframes nucleusReveal {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.78);
  }
  68% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.06);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes nucleusHide {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.78);
  }
}

@keyframes guideReveal {
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes guideHide {
  from {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  to {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.86);
  }
}

@keyframes linesCollapse {
  0% {
    opacity: 0.9;
    transform: scale(1);
  }
  72% {
    opacity: 0.35;
  }
  100% {
    opacity: 0;
    transform: scale(0.22);
  }
}

@keyframes linesExpand {
  0% {
    opacity: 0;
    transform: scale(0.22);
  }
  100% {
    opacity: 0.9;
    transform: scale(1);
  }
}

@keyframes orbitClockwise {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes orbitCounterClockwise {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

@media (max-width: 640px) {
  .section {
    padding-inline: 14px;
  }

  .heading {
    margin-bottom: 20px;
  }

  .subtitle {
    font-size: 14px;
  }

  .orbitStage {
    --inner-radius: clamp(78px, 26vw, 104px);
    --outer-radius: clamp(126px, 41vw, 158px);
    height: 430px;
  }

  .photoFrame {
    border-width: 3px;
  }

  .caption {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .constellationLines,
  .isVisible .constellationLines,
  .ringGuide,
  .isVisible .ringGuide,
  .nucleus,
  .isVisible .nucleus,
  .orbitRing,
  .isVisible .orbitRing,
  .orbitSlot,
  .isVisible .orbitSlot {
    animation: none !important;
  }

  .constellationLines {
    opacity: 0;
  }

  .ringGuide,
  .nucleus {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .orbitRing {
    opacity: 1;
  }

  .orbitSlot {
    opacity: 1;
    transform:
      translate(-50%, -50%)
      rotate(var(--orbit-angle))
      translateX(var(--orbit-radius))
      rotate(var(--counter-angle))
      scale(1);
  }

  .inner {
    transform: none;
  }

  .scrollBridge {
    display: none;
  }
}
